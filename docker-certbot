#!/bin/bash

source /opt/certbot/bin/activate

LOG_FILE="/var/log/certificados.log"

# Verifica se as variáveis de ambiente estão definidas e loga em caso de erro
if [ -z "$CLOUDFLARE_EMAIL" ]; then
  echo "[$(date)] Erro: A variável CLOUDFLARE_EMAIL não está definida." >> "$LOG_FILE"
  exit 1
fi
if [ -z "$CLOUDFLARE_API_KEY" ]; then
  echo "[$(date)] Erro: A variável CLOUDFLARE_API_KEY não está definida." >> "$LOG_FILE"
  exit 1
fi
if [ -z "$MY_DOMAINS" ]; then
  echo "[$(date)] Erro: A variável MY_DOMAINS não está definida." >> "$LOG_FILE"
  exit 1
fi
if [ -z "$DRY_RUN" ]; then
  echo "[$(date)] Erro: A variável DRY_RUN não está definida." >> "$LOG_FILE"
  exit 1
fi

# Define o diretório de saída dos certificados (padrão: /certificates)
CERT_OUTPUT_DIR="${CERT_OUTPUT_DIR:-/certificates}"

# Remove aspas simples ou duplas para evitar erros em caminhos e valores
CLEAN_CLOUDFLARE_EMAIL=$(echo "$CLOUDFLARE_EMAIL" | tr -d '"'\''')
DRY_RUN=$(echo "$DRY_RUN" | tr -d '"'\''')
CERT_OUTPUT_DIR=$(echo "$CERT_OUTPUT_DIR" | tr -d '"'\''')
TARGET_COMPOSE_FILE=$(echo "$TARGET_COMPOSE_FILE" | tr -d '"'\''')

# Diretórios para configuração e logs
CERT_DIR="/etc/letsencrypt"
LOG_DIR="/var/log/letsencrypt"

# Cria o arquivo cloudflare.ini com o e-mail limpo
echo "dns_cloudflare_email = $CLEAN_CLOUDFLARE_EMAIL" > /etc/cloudflare.ini
echo "dns_cloudflare_api_key = $CLOUDFLARE_API_KEY" >> /etc/cloudflare.ini

# Converte a string de domínios em um array usando a vírgula como separador
DOMAINS=()
while IFS= read -r -d ',' domain; do
  # Remove espaços e aspas do domínio
  clean_domain=$(echo "$domain" | tr -d '[:space:]\"'\''')
  if [ -n "$clean_domain" ]; then
    DOMAINS+=("$clean_domain")
  fi
done <<< "$MY_DOMAINS,"

# Monta a lista de domínios para o comando Certbot
DOMAIN_ARGS=""
for domain in "${DOMAINS[@]}"; do
  DOMAIN_ARGS="$DOMAIN_ARGS -d $domain"
done

# Constrói os argumentos do Certbot com o e-mail limpo
CERTBOT_ARGS="--non-interactive --expand --dns-cloudflare --dns-cloudflare-credentials /etc/cloudflare.ini --dns-cloudflare-propagation-seconds 15 --agree-tos --email $CLEAN_CLOUDFLARE_EMAIL $DOMAIN_ARGS --verbose"

# Adiciona --dry-run se DRY_RUN for true
if [ "$DRY_RUN" = "true" ]; then
  CERTBOT_ARGS="--dry-run $CERTBOT_ARGS"
fi

# Verifica se os diretórios existem
for dir in "$CERT_DIR" "$LOG_DIR" "$CERT_OUTPUT_DIR"; do
  if [ ! -d "$dir" ]; then
    echo "[$(date)] AVISO: Diretório $dir não existe. Criando..." >> "$LOG_FILE"
    mkdir -p "$dir"
    chmod 700 "$dir"
  fi
done

# Verifica se o arquivo cloudflare.ini existe
if [ ! -f /etc/cloudflare.ini ]; then
  echo "[$(date)] ERRO: Arquivo /etc/cloudflare.ini não encontrado." >> "$LOG_FILE"
  exit 1
fi

# Garante permissões seguras para o arquivo de credenciais
chmod 600 /etc/cloudflare.ini

# Executa o Certbot para renovar ou expandir certificados
echo "[$(date)] Iniciando verificação/renovação de certificados Let's Encrypt..." >> "$LOG_FILE"
certbot certonly $CERTBOT_ARGS >> "$LOG_FILE" 2>&1

# Verifica o status da execução
if [ $? -eq 0 ]; then
  echo "[$(date)] Sucesso: Processo do Certbot finalizado (sem erros)." >> "$LOG_FILE"
  
  # Copia os certificados do primeiro domínio para o diretório de saída com nomes específicos
  if [ ${#DOMAINS[@]} -gt 0 ]; then
    domain="${DOMAINS[0]}"
    # Remove o prefixo *. se presente (para domínios wildcard)
    cert_domain=$(echo "$domain" | sed 's/^\*\.//')
    CERT_PATH="/etc/letsencrypt/live/$cert_domain"
    
    if [ -d "$CERT_PATH" ]; then
      echo "[$(date)] Analisando certificados de $cert_domain..." >> "$LOG_FILE"
      
      # 1. Pega o hash atual do certificado ANTES da cópia
      # Se não existir ainda, define um valor fictício para forçar a detecção de "mudança"
      if [ -f "$CERT_OUTPUT_DIR/cert.pem" ]; then
        OLD_CERT_HASH=$(md5sum "$CERT_OUTPUT_DIR/cert.pem" | awk '{print $1}')
      else
        OLD_CERT_HASH="novo_certificado_inédito"
      fi
      
      # Faz a cópia dos certificados
      cp "$CERT_PATH/fullchain.pem" "$CERT_OUTPUT_DIR/cert.pem" 2>> "$LOG_FILE"
      cp "$CERT_PATH/privkey.pem" "$CERT_OUTPUT_DIR/key.pem" 2>> "$LOG_FILE"
      
      if [ $? -eq 0 ]; then
        echo "[$(date)] OK: Arquivos pem mais recentes copiados para $CERT_OUTPUT_DIR." >> "$LOG_FILE"
        chmod 600 "$CERT_OUTPUT_DIR/cert.pem" "$CERT_OUTPUT_DIR/key.pem"
        
        # 2. Pega o hash do certificado DEPOIS da cópia
        NEW_CERT_HASH=$(md5sum "$CERT_OUTPUT_DIR/cert.pem" | awk '{print $1}')
        
        # 3. Compara os hashes para saber se o arquivo realmente mudou (renovação ocorreu)
        if [ "$OLD_CERT_HASH" != "$NEW_CERT_HASH" ]; then
            echo "[$(date)] ATENÇÃO: Certificados novos detectados (o hash mudou)! Preparando restart dos serviços..." >> "$LOG_FILE"
            
            # Verifica se a variável TARGET_COMPOSE_FILE foi definida no docker-compose.yml
            if [ -n "$TARGET_COMPOSE_FILE" ] && [ -f "$TARGET_COMPOSE_FILE" ]; then
                # Descobre a pasta onde o arquivo yml está
                COMPOSE_DIR=$(dirname "$TARGET_COMPOSE_FILE")
                
                echo "[$(date)] Executando update no diretório: $COMPOSE_DIR" >> "$LOG_FILE"
                            
                # Entra na pasta e dispara o docker compose (assim ele lê o override.yml magicamente)
                cd "$COMPOSE_DIR" && docker compose up -d --force-recreate nginx-mailcow postfix-mailcow dovecot-mailcow >> "$LOG_FILE" 2>&1
                
                if [ $? -eq 0 ]; then
                    echo "[$(date)] SUCESSO: Contêineres alvo foram recriados e reiniciados com o novo certificado." >> "$LOG_FILE"
                else
                    echo "[$(date)] ERRO: O comando docker compose falhou. Verifique se o plugin 'docker-cli-compose' está instalado e o /var/run/docker.sock foi mapeado corretamente." >> "$LOG_FILE"
                fi
            else
                echo "[$(date)] AVISO: TARGET_COMPOSE_FILE não definida ou arquivo inacessível ($TARGET_COMPOSE_FILE). Nenhuma ação de restart foi acionada." >> "$LOG_FILE"
            fi
        else
            echo "[$(date)] CHECK: O certificado não venceu ainda e os arquivos continuam iguais (hash idêntico). Restart do Docker Compose ignorado." >> "$LOG_FILE"
        fi
        
      else
        echo "[$(date)] ERRO: Falha ao tentar copiar de $CERT_PATH para $CERT_OUTPUT_DIR." >> "$LOG_FILE"
        exit 1
      fi
    else
      echo "[$(date)] ERRO: Diretório base do Let's Encrypt ($CERT_PATH) não encontrado." >> "$LOG_FILE"
      exit 1
    fi
  else
    echo "[$(date)] ERRO: Não foi possível processar a variável MY_DOMAINS." >> "$LOG_FILE"
    exit 1
  fi
else
  echo "[$(date)] ERRO: Falha grave na execução do Certbot. Analise os detalhes acima." >> "$LOG_FILE"
  exit 1
fi
